# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OpenAI API (Required for embeddings and chat)
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Optional: Configure different models
# The app uses text-embedding-3-small for embeddings and gpt-4o-mini for chat
# You can modify these in src/lib/embeddings.ts and src/lib/rag.ts if needed
